default_platform(:ios)

APP_IDENTIFIER = "com.danmalgi.mobile"
TEAM_ID        = "55225WA4WM"
PROFILE_NAME   = "match AppStore #{APP_IDENTIFIER}"

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id:                ENV.fetch("ASC_KEY_ID"),
      issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
      key_content:           ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house:              false
    )
  end

  desc "인증서/프로파일 생성·갱신 후 저장소에 push  (로컬에서만 실행)"
  lane :refresh_certificates do
    match(
      type:           "appstore",
      readonly:       false,
      app_identifier: APP_IDENTIFIER
    )
  end

  desc "CI: 서명 자산을 내려받아 설치(readonly) + 프로젝트를 수동 서명으로 전환"
  lane :certificates do
    setup_ci
    match(
      type:           "appstore",
      readonly:       true,
      app_identifier: APP_IDENTIFIER
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "Runner.xcodeproj",
      team_id:               TEAM_ID,
      code_sign_identity:    "Apple Distribution",
      bundle_identifier:     APP_IDENTIFIER,
      profile_name:          PROFILE_NAME,
      targets:               ["Runner"]
    )
  end

  desc "CI: 빌드된 ipa를 TestFlight에 업로드"
  lane :upload do |options|
    ipa = options[:ipa] || Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("ipa를 찾을 수 없습니다 (build/ios/ipa/*.ipa)") if ipa.nil?

    upload_to_testflight(
      ipa:                          ipa,
      skip_waiting_for_build_processing: true,
      distribute_external:          false,
      changelog:                    options[:changelog]
    )
  end
end